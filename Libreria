    Create("Frame", {
        BackgroundColor3 = Color3.fromRGB(30, 30, 30),
        BorderSizePixel = 0,
        Position = UDim2.new(0, 12, 0, 62),
        Size = UDim2.new(1, -24, 0, 1)
    }, Sidebar)

    -- Contenedor de Botones de Pestañas
    local TabButtonsScroll = Create("ScrollingFrame", {
        Name = "TabButtonsScroll",
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 0, 72),
        Size = UDim2.new(1, 0, 1, -78),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        ScrollBarThickness = 2
    }, Sidebar)

    local TabButtonsLayout = Create("UIListLayout", {
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 6)
    }, TabButtonsScroll)

    -- Contenedor de Páginas (Derecha)
    local PagesContainer = Create("Frame", {
        Name = "PagesContainer",
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 155, 0, 0),
        Size = UDim2.new(1, -155, 1, 0)
    }, Container)

    local WindowObj = {}
    local firstTab = true

    -- Crear Pestaña
    function WindowObj:CreateTab(tabName)
        local TabButton = Create("TextButton", {
            Font = Enum.Font.GothamMedium,
            Text = "  " .. tabName,
            TextColor3 = Color3.fromRGB(160, 160, 160),
            TextSize = 13,
            BackgroundColor3 = Color3.fromRGB(25, 25, 25),
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -16, 0, 32),
            TextXAlignment = Enum.TextXAlignment.Left
        }, TabButtonsScroll)

        Create("UICorner", {CornerRadius = UDim.new(0, 6)}, TabButton)

        local TabPage = Create("ScrollingFrame", {
            Name = tabName .. "Page",
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 12, 0, 12),
            Size = UDim2.new(1, -24, 1, -24),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 3,
            Visible = false
        }, PagesContainer)

        local PageLayout = Create("UIListLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            Padding = UDim.new(0, 8)
        }, TabPage)

        PageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            TabPage.CanvasSize = UDim2.new(0, 0, 0, PageLayout.AbsoluteContentSize.Y + 10)
        end)

        if firstTab then
            firstTab = false
            TabPage.Visible = true
            TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            TabButton.BackgroundTransparency = 0.2
        end

        TabButton.MouseButton1Click:Connect(function()
            for _, page in ipairs(PagesContainer:GetChildren()) do
                if page:IsA("ScrollingFrame") then page.Visible = false end
            end
            for _, btn in ipairs(TabButtonsScroll:GetChildren()) do
                if btn:IsA("TextButton") then
                    btn.TextColor3 = Color3.fromRGB(160, 160, 160)
                    btn.BackgroundTransparency = 1
                end
            end
            TabPage.Visible = true
            TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
            TabButton.BackgroundTransparency = 0.2
        end)

        -- Métodos internos
        local TabElements = {}

        function TabElements:CreateToggle(config, callback)
            local toggleName = config.Name or "Toggle"
            local defaultState = config.Default or false
            local currentState = defaultState

            local ToggleButton = Create("TextButton", {
                Font = Enum.Font.GothamMedium,
                Text = "  " .. toggleName,
                TextColor3 = Color3.fromRGB(200, 200, 200),
                TextSize = 12,
                BackgroundColor3 = Color3.fromRGB(25, 25, 25),
                BackgroundTransparency = 0.2,
                Size = UDim2.new(1, -6, 0, 36),
                TextXAlignment = Enum.TextXAlignment.Left
            }, TabPage)

            Create("UICorner", {CornerRadius = UDim.new(0, 6)}, ToggleButton)

            local StatusIndicator = Create("Frame", {
                BackgroundColor3 = currentState and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(60, 60, 60),
                BorderSizePixel = 0,
                Position = UDim2.new(1, -28, 0.5, -9),
                Size = UDim2.new(0, 18, 0, 18),
                AnchorPoint = Vector2.new(0, 0.5)
            }, ToggleButton)

            Create("UICorner", {CornerRadius = UDim.new(1, 0)}, StatusIndicator)

            local function updateToggle()
                if currentState then
                    TweenService:Create(StatusIndicator, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0, 255, 100)}):Play()
                else
                    TweenService:Create(StatusIndicator, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60, 60, 60)}):Play()
                end
                pcall(callback, currentState)
            end

            ToggleButton.MouseButton1Click:Connect(function()
                currentState = not currentState
                updateToggle()
            end)

            if defaultState then
                pcall(callback, true)
            end

            return ToggleButton
        end

        return TabElements
    end

    return WindowObj
end

return Library
