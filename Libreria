        BackgroundColor3 = Color3.fromRGB(22, 22, 30),
        BorderSizePixel = 0,
        Text = windowTitle,
        TextColor3 = Color3.fromRGB(235, 235, 255),
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        Visible = false,
        AutoButtonColor = false
    }, ScreenGui)
    Create("UICorner", {CornerRadius = UDim.new(0, 10)}, MiniButton)
    local MiniStroke = Create("UIStroke", {Color = Color3.fromRGB(95, 70, 190), Thickness = 1.5}, MiniButton)

    -- Animación RGB Continua
