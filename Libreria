        while ScreenGui.Parent do
            MainGradient.Rotation = (MainGradient.Rotation + 2) % 360
            task.wait(0.03)
        end
    end)

    -- Barra de Arrastre (DragBar Superior)
    local DragBar = Create("Frame", {
        Size = UDim2.new(1, -90, 0, 35),
        Position = UDim2.new(0, 90, 0, 0),
