        MainRGBFrame.Visible = false
        MiniButton.Visible = true
    end)

    MiniButton.MouseButton1Click:Connect(function()
        MiniButton.Visible = false
        MainRGBFrame.Visible = true
    end)

    -- Sidebar (Panel Izquierdo con Pestañas)
    local Sidebar = Create("Frame", {
        Size = UDim2.new(0, 110, 1, 0),
        BackgroundColor3 = Color3.fromRGB(12, 12, 16),
        BorderSizePixel = 0
    }, MainFrame)
    Create("UICorner", {CornerRadius = UDim.new(0, 10)}, Sidebar)

    -- Logo / Título Sidebar
    local LogoTitle = Create("TextLabel", {
        Size = UDim2.new(1, -10, 0, 35),
        Position = UDim2.new(0, 10, 0, 8),
        BackgroundTransparency = 1,
        Text = windowTitle,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Font = Enum.Font.GothamBold,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left
    }, Sidebar)

    local NavContainer = Create("Frame", {
        Size = UDim2.new(1, -10, 1, -48),
        Position = UDim2.new(0, 5, 0, 45),
        BackgroundTransparency = 1
    }, Sidebar)

    Create("UIListLayout", {
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, NavContainer)

    -- Contenedor de Páginas (Derecha)
    local ContentContainer = Create("Frame", {
        Size = UDim2.new(1, -115, 1, -8),
        Position = UDim2.new(0, 112, 0, 4),
        BackgroundTransparency = 1
    }, MainFrame)

    local WindowObj = {}
    local pages = {}
    local firstTab = true

    function WindowObj:CreateTab(name, iconChar)
        local btn = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 30),
            BackgroundColor3 = Color3.fromRGB(12, 12, 16),
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false
        }, NavContainer)
        Create("UICorner", {CornerRadius = UDim.new(0, 8)}, btn)

        local iconLabel = Create("TextLabel", {
            Size = UDim2.new(0, 20, 1, 0),
            Position = UDim2.new(0, 6, 0, 0),
            BackgroundTransparency = 1,
            Text = iconChar or name:sub(1, 1),
            TextColor3 = Color3.fromRGB(160, 160, 180),
            Font = Enum.Font.GothamBold,
            TextSize = 10
        }, btn)

        local textLabel = Create("TextLabel", {
            Size = UDim2.new(1, -28, 1, 0),
            Position = UDim2.new(0, 26, 0, 0),
            BackgroundTransparency = 1,
            Text = name,
            TextColor3 = Color3.fromRGB(180, 180, 200),
            Font = Enum.Font.GothamMedium,
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Left
        }, btn)

        local indicator = Create("Frame", {
            Size = UDim2.new(0, 3, 0, 18),
            Position = UDim2.new(0, 0, 0.5, -9),
            BackgroundColor3 = Color3.fromRGB(120, 80, 255),
            BorderSizePixel = 0,
            Visible = false
        }, btn)
        Create("UICorner", {CornerRadius = UDim.new(0, 2)}, indicator)

        -- Página de Contenido
        local page = Create("ScrollingFrame", {
            Size = UDim2.new(1, -10, 1, -10),
            Position = UDim2.new(0, 5, 0, 5),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            Visible = false
        }, ContentContainer)

        local pageLayout = Create("UIListLayout", {
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder
        }, page)

        pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            page.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + 15)
        end)

        if firstTab then
            firstTab = false
            page.Visible = true
            btn.BackgroundColor3 = Color3.fromRGB(28, 24, 45)
            indicator.Visible = true
            iconLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        end

        btn.MouseButton1Click:Connect(function()
            for _, p in pairs(pages) do p.Visible = false end
            page.Visible = true

            for _, child in ipairs(NavContainer:GetChildren()) do
                if child:IsA("TextButton") then
                    child.BackgroundColor3 = Color3.fromRGB(12, 12, 16)
                    child.FindFirstChild(child, "Indicator").Visible = false
                    child.FindFirstChild(child, "TextLabel").TextColor3 = Color3.fromRGB(180, 180, 200)
                end
            end
            btn.BackgroundColor3 = Color3.fromRGB(28, 24, 45)
            indicator.Visible = true
            iconLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
            textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
        end)

        pages[name] = page

        local TabMethods = {}

        function TabMethods:AddSection(secText)
            local sec = Create("TextLabel", {
                Size = UDim2.new(1, 0, 0, 20),
                BackgroundTransparency = 1,
                Text = string.upper(secText),
                TextColor3 = Color3.fromRGB(130, 100, 200),
                Font = Enum.Font.GothamBold,
                TextSize = 11,
                TextXAlignment = Enum.TextXAlignment.Left
            }, page)
            return sec
        end

        function TabMethods:CreateToggle(config, callback)
            local titleText = config.Name or "Toggle"
            local descText = config.Description or ""
            local defaultState = config.Default or false
            local currentState = defaultState

            local row = Create("Frame", {
                Size = UDim2.new(1, -5, 0, descText ~= "" and 52 or 40),
                BackgroundColor3 = Color3.fromRGB(24, 24, 30),
                BorderSizePixel = 0
            }, page)
            Create("UICorner", {CornerRadius = UDim.new(0, 8)}, row)

            Create("TextLabel", {
                Size = UDim2.new(1, -75, 0, 20),
                Position = UDim2.new(0, 12, 0, descText ~= "" and 8 or 10),
                BackgroundTransparency = 1,
                Text = titleText,
                TextColor3 = Color3.fromRGB(240, 240, 250),
                Font = Enum.Font.GothamBold,
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left
            }, row)

            if descText ~= "" then
                Create("TextLabel", {
                    Size = UDim2.new(1, -75, 0, 16),
                    Position = UDim2.new(0, 12, 0, 28),
                    BackgroundTransparency = 1,
                    Text = descText,
                    TextColor3 = Color3.fromRGB(130, 130, 150),
                    Font = Enum.Font.Gotham,
                    TextSize = 10,
                    TextXAlignment = Enum.TextXAlignment.Left
                }, row)
            end

            local switchBg = Create("Frame", {
                Size = UDim2.new(0, 42, 0, 24),
                Position = UDim2.new(1, -52, 0.5, -12),
                BackgroundColor3 = currentState and Color3.fromRGB(100, 70, 220) or Color3.fromRGB(50, 50, 60),
                BorderSizePixel = 0
            }, row)
            Create("UICorner", {CornerRadius = UDim.new(1, 0)}, switchBg)

            local knob = Create("Frame", {
                Size = UDim2.new(0, 18, 0, 18),
                Position = currentState and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
                BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                BorderSizePixel = 0
            }, switchBg)
            Create("UICorner", {CornerRadius = UDim.new(1, 0)}, knob)

            local clickBtn = Create("TextButton", {
                Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1,
                Text = ""
            }, row)

            clickBtn.MouseButton1Click:Connect(function()
                currentState = not currentState
                local tweenInfo = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
                if currentState then
                    TweenService:Create(switchBg, tweenInfo, {BackgroundColor3 = Color3.fromRGB(100, 70, 220)}):Play()
                    TweenService:Create(knob, tweenInfo, {Position = UDim2.new(1, -21, 0.5, -9)}):Play()
                else
                    TweenService:Create(switchBg, tweenInfo, {BackgroundColor3 = Color3.fromRGB(50, 50, 60)}):Play()
                    TweenService:Create(knob, tweenInfo, {Position = UDim2.new(0, 3, 0.5, -9)}):Play()
                end
                pcall(callback, currentState)
            end)

            if defaultState then
                pcall(callback, true)
            end

            return row
        end

        return TabMethods
    end

    return WindowObj
end

return Library
